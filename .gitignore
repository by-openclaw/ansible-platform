*.retry
*.pyc
__pycache__/
.pytest_cache/
.tox/
.cache/
.molecule/
molecule/*/molecule.yml
*.log

# Secrets — never committed
**/vault_password*
**/sasl_passwd
**/.vault_pass
inventories/**/host_vars/**/*vault*
*secret*
# Ansible role task files named secrets.yml are CODE (tasks only — passwords are
# generated at runtime + stored in the external secret store, never in-repo).
!roles/**/tasks/secrets.yml
# The vault_secret role is CODE (Vault get/create helper — no secret values in it).
# Re-include the whole role dir (the *secret* rule above otherwise excludes it).
!roles/vault_secret/
!roles/vault_secret/**
# The secrets->Vault migration + validation playbooks are CODE (paths + logic; no
# secret values — creds are read from Vault at runtime and passed via env).
!playbooks/secrets-to-vault.yml
!playbooks/secrets-validate.yml
!playbooks/tasks/secret_validate_one.yml
*.env
files/client-configs/*.conf
# service_decommission helper is CODE (Vault archive logic; no secret values).
!roles/service_decommission/files/vault_archive_secret.py
