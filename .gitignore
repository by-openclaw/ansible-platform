*.retry
*.pyc
__pycache__/
.pytest_cache/
.tox/
.cache/
.molecule/
molecule/*/molecule.yml
*.log

# Secrets — never committed
**/vault_password*
**/sasl_passwd
**/.vault_pass
inventories/**/host_vars/**/*vault*
*secret*
# Ansible role task files named secrets.yml are CODE (tasks only — passwords are
# generated at runtime + stored in the external secret store, never in-repo).
!roles/**/tasks/secrets.yml
*.env
files/client-configs/*.conf
