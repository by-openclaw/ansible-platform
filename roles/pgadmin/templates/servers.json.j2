{
    "Servers": {
        "1": {
            "Name": "{{ pgadmin_pg_server_name }}",
            "Group": "BY-RESEARCH",
            "Host": "{{ pgadmin_pg_host }}",
            "Port": {{ pgadmin_pg_port }},
            "MaintenanceDB": "{{ pgadmin_pg_maintenance_db }}",
            "Username": "{{ pgadmin_pg_username }}",
            "SharedUsername": "{{ pgadmin_pg_shared_username }}",
            "SSLMode": "{{ pgadmin_pg_sslmode }}",
            "Shared": true,
            "Comment": "Provisioned by Ansible (pgadmin role). Password not stored — supplied on connect (Vault later)."
        }
    }
}
