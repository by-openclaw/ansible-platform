{# Managed by Ansible role `authentik`. Do not edit by hand.
   Authentik blueprint: one OIDC (OAuth2) application per cluster service.
   Declarative + self-reconciling — Authentik re-applies on change. References the
   instance's real default flows / signing key / scope mappings (verified live). #}
version: 1
metadata:
  name: oidc-{{ app.slug }}
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  # Access group for this service (map → svc role/policy on the service side).
  - model: authentik_core.group
    id: group-{{ app.slug }}
    identifiers:
      name: {{ app.group }}
    attrs:
      name: {{ app.group }}

  # Custom scope mapping → emit the user's group names in the `groups` claim
  # (the default `profile` scope does not include groups in this instance).
  - model: authentik_providers_oauth2.scopemapping
    id: scope-groups-{{ app.slug }}
    identifiers:
      name: "OIDC groups ({{ app.slug }})"
    attrs:
      name: "OIDC groups ({{ app.slug }})"
      scope_name: groups
      description: "User group names for {{ app.slug }} RBAC"
      expression: |
        groups = [group.name for group in request.user.ak_groups.all()]
{% if app.admin_group_alias is defined %}
        # Emit the app's native admin group name (e.g. nextcloud "admin") when the
        # user is in the admin SOURCE group (defaults to the access group), so
        # group-provisioning grants admin. Decoupling access vs admin lets a broad
        # access group (e.g. nextcloud-users) log in while only the admin source
        # group (nextcloud-admins) gets elevated.
        if "{{ app.admin_source_group | default(app.group) }}" in groups:
            groups.append("{{ app.admin_group_alias }}")
{% endif %}
        return {"groups": groups}
{% if app.force_email_verified | default(false) %}

  # Custom `email` scope mapping that asserts email_verified=True. authentik's
  # default email mapping hardcodes email_verified=False, which clients like
  # vaultwarden reject ("verify your email with your provider"). Used in place of
  # the default email mapping for apps that set force_email_verified.
  - model: authentik_providers_oauth2.scopemapping
    id: scope-emailverified-{{ app.slug }}
    identifiers:
      name: "OIDC email+verified ({{ app.slug }})"
    attrs:
      name: "OIDC email+verified ({{ app.slug }})"
      scope_name: email
      description: "email + email_verified=True for {{ app.slug }}"
      expression: |
        return {"email": request.user.email, "email_verified": True}
{% endif %}

  # Confidential OIDC provider (client_id/secret generated by Ansible, fed to the
  # service unchanged so the loop is idempotent on both sides).
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-{{ app.slug }}
    identifiers:
      name: {{ app.slug }}
    attrs:
      name: {{ app.slug }}
      # Most apps are confidential (client_secret). NetBird's dashboard is a public
      # SPA doing PKCE, so it must be a PUBLIC client (override per app).
      client_type: {{ app.client_type | default('confidential') }}
{% if app.sub_mode is defined %}
      # `sub` claim source. Proxmox VE maps its username from this — the
      # goauthentik.io PVE guide uses the user's email (sub_mode: user_email).
      sub_mode: {{ app.sub_mode }}
{% endif %}
      # Authentik 2026.x defaults grant_types to [] (empty = no flow permitted),
      # which makes any token request fail with "Invalid grant_type for provider".
      # Must be set explicitly. extra_grant_types adds non-interactive grants — e.g.
      # NetBird needs client_credentials (IdP-manager user sync + JWT→account
      # resolution; login completes then drops without it) and the device-code grant
      # (CLI / mobile `netbird up`).
      grant_types:
        - authorization_code
        - refresh_token
{% for gt in app.extra_grant_types | default([]) %}
        - {{ gt }}
{% endfor %}
      client_id: "{{ app.client_id }}"
      client_secret: "{{ app.client_secret }}"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      redirect_uris:
{% for uri in app.redirect_uris | default([]) %}
        - matching_mode: strict
          url: "{{ uri }}"
          redirect_uri_type: authorization
{% endfor %}
{% for uri in app.redirect_uris_regex | default([]) %}
        # regex match — for callbacks with a server-generated path segment (e.g.
        # NetBird's embedded-Dex /oauth2/callback/<connector-id>). SINGLE-quoted so
        # the regex backslashes (\.) survive YAML parsing of the blueprint.
        - matching_mode: regex
          url: '{{ uri }}'
          redirect_uri_type: authorization
{% endfor %}
{% for uri in app.logout_uris | default([]) %}
        # RP-initiated logout: authentik validates post_logout_redirect_uri ONLY
        # against URIs of type `logout`, so these must be registered separately.
        - matching_mode: strict
          url: "{{ uri }}"
          redirect_uri_type: logout
{% endfor %}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
{% if app.force_email_verified | default(false) %}
        # custom email mapping (email_verified=True) instead of the default
        - !KeyOf scope-emailverified-{{ app.slug }}
{% else %}
        - !Find [authentik_providers_oauth2.scopemapping, [managed, "goauthentik.io/providers/oauth2/scope-email"]]
{% endif %}
{% if app.offline_access | default(false) %}
        # refresh-token support (client requests the offline_access scope)
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, offline_access]]
{% endif %}
{% if app.entitlements | default(false) %}
        # entitlements scope (per the goauthentik.io NetBird guide)
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, entitlements]]
{% endif %}
{% if app.api_access | default(false) %}
        # authentik API access (goauthentik.io/api) — NetBird's IdP manager uses the
        # client_credentials grant with this scope to read the user directory.
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, "goauthentik.io/api"]]
{% endif %}
        - !KeyOf scope-groups-{{ app.slug }}

  # Application tile bound to the provider.
  - model: authentik_core.application
    id: app-{{ app.slug }}
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name }}
      slug: {{ app.slug }}
      provider: !KeyOf provider-{{ app.slug }}
{% if app.icon is defined and app.icon %}
      meta_icon: "{{ app.icon }}"
{% endif %}
{% if app.launch_url is defined and app.launch_url %}
      # Explicit tile link. Without it Authentik derives the launch URL from the
      # provider's redirect URI — which for a REGEX redirect (e.g. netbird) renders
      # the escaped pattern (https://vpn\.by-research\.be...). Set it cleanly here.
      meta_launch_url: "{{ app.launch_url }}"
{% endif %}
{% if app.restrict_to_group | default(false) %}

  # RBAC: bind the access group to the application so ONLY its members can launch
  # / authenticate to it (enforced at the IdP). Opt-in per app via restrict_to_group.
  - model: authentik_policies.policybinding
    id: binding-{{ app.slug }}-group
    identifiers:
      target: !KeyOf app-{{ app.slug }}
      group: !KeyOf group-{{ app.slug }}
      order: 0
    attrs:
      enabled: true
      negate: false
{% endif %}
