{# Managed by Ansible role `authentik`. Declarative groups + human users.
   Passwords are NOT set here (Authentik hashes them) — they are set via the API
   after this blueprint creates the users. #}
version: 1
metadata:
  name: identity-core
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
{% for g in authentik_groups %}
  - model: authentik_core.group
    id: group-{{ g }}
    identifiers:
      name: {{ g }}
    attrs:
      name: {{ g }}
{% if g in authentik_superuser_groups %}
      is_superuser: true
{% endif %}
{% endfor %}
{% for sa in authentik_service_accounts %}
  - model: authentik_core.user
    id: sa-{{ sa.username }}
    identifiers:
      username: {{ sa.username }}
    attrs:
      username: {{ sa.username }}
      name: "{{ sa.name }}"
      is_active: true
      type: service_account
      groups:
{% for g in sa.groups %}
        - !Find [authentik_core.group, [name, {{ g }}]]
{% endfor %}
    permissions:
{% for perm in sa.permissions %}
      - {{ perm }}
{% endfor %}
{% endfor %}
{% for u in authentik_users_resolved %}
  - model: authentik_core.user
    id: user-{{ u.username }}
    identifiers:
      username: {{ u.username }}
    attrs:
      username: {{ u.username }}
      name: "{{ u.name }}"
      email: {{ u.email }}
      is_active: true
      type: internal
      groups:
{% for g in u.groups %}
        - !Find [authentik_core.group, [name, {{ g }}]]
{% endfor %}
{% endfor %}
