{# Managed by Ansible (netbox role). NetBox configuration is Python (Django);
   netbox-docker loads every *.py in /etc/netbox/config/. This file adds OIDC
   group->role RBAC, which has no env/YAML equivalent in NetBox. #}
# Request the `groups` claim from Authentik (NetBox's default OIDC scope omits it).
SOCIAL_AUTH_OIDC_SCOPE = ['groups']


def oidc_set_roles(backend, user, response=None, *args, **kwargs):
    """social-auth pipeline step: map the Authentik `groups` claim to NetBox
    roles. Members of the admin group become superuser/staff; non-members are
    demoted. Idempotent — runs on every OIDC login."""
    if user is None or getattr(backend, 'name', '') != 'oidc':
        return
    groups = (response or {}).get('groups') or []
    is_admin = '{{ netbox_oidc_superuser_group }}' in groups
    if user.is_superuser != is_admin or user.is_staff != is_admin:
        user.is_superuser = is_admin
        user.is_staff = is_admin
        user.save()


# Default NetBox v4 pipeline (pinned image) + our role-mapping step appended.
SOCIAL_AUTH_PIPELINE = (
    'social_core.pipeline.social_auth.social_details',
    'social_core.pipeline.social_auth.social_uid',
    'social_core.pipeline.social_auth.social_user',
    'social_core.pipeline.user.get_username',
    'social_core.pipeline.user.create_user',
    'social_core.pipeline.social_auth.associate_user',
    'netbox.authentication.user_default_groups_handler',
    'social_core.pipeline.social_auth.load_extra_data',
    'social_core.pipeline.user.user_details',
    'netbox.configuration.extra.oidc_set_roles',
)
