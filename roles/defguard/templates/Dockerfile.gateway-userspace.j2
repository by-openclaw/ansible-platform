# Derived defguard gateway image with wireguard-go bundled, so the gateway can
# run in USERSPACE mode (DEFGUARD_USERSPACE=1). The stock gateway image does NOT
# ship wireguard-go, and this LXC is unprivileged+nesting (no host wg kernel
# module — same failure class as keyctl). Userspace = no host kernel dependency.
# Rendered + built by roles/defguard (containers.yml). Pinned base + builder.
FROM {{ defguard_go_builder_image }} AS builder
RUN apk add --no-cache git make bash
RUN git clone {{ defguard_wireguard_go_git }} /src/wireguard-go \
    && cd /src/wireguard-go \
    && make

FROM {{ defguard_gateway_base_image }}
COPY --from=builder /src/wireguard-go/wireguard-go /usr/local/bin/wireguard-go
RUN chmod +x /usr/local/bin/wireguard-go
