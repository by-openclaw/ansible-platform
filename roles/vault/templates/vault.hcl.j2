{# Managed by Ansible role `vault`. Do not edit by hand. #}
ui            = true
# LXC: avoid the IPC_LOCK capability requirement (unprivileged container).
disable_mlock = true

storage "raft" {
  path    = "/vault/data"
  node_id = "{{ vault_node_id }}"
{% for m in vault_members if m != inventory_hostname %}
  # Read at start only: a node with no data joins a member that answers; one that has its
  # data ignores it.
  retry_join {
    leader_api_addr = "https://{{ m }}.{{ platform_domain }}:{{ vault_port }}"
  }
{% endfor %}
}

listener "tcp" {
  address       = "0.0.0.0:{{ vault_port }}"
  tls_cert_file = "{{ vault_tls_cert }}"
  tls_key_file  = "{{ vault_tls_key }}"
}

api_addr     = "https://{{ vault_node_fqdn }}:{{ vault_port }}"
cluster_addr = "https://{{ vault_node_fqdn }}:{{ vault_cluster_port }}"
