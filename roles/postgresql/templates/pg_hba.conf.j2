{# Managed by Ansible role `postgresql` (container). Do not edit by hand. #}
# TYPE   DATABASE  USER  ADDRESS         METHOD
local    all       all                   trust
host     all       all   127.0.0.1/32    scram-sha-256
host     all       all   ::1/128         scram-sha-256
# App access from the SVC zone only (source IP preserved via Docker DNAT).
# {{ pg_app_hba_type }} = hostssl forces TLS for remote app connections.
{% for cidr in pg_app_cidrs %}
{{ pg_app_hba_type }}  all       all   {{ cidr }}      scram-sha-256
{% endfor %}
{% if pg_exporter_hba_user %}
# Metrics only: PostgreSQL runs in a container, so a client on this host arrives as the docker
# bridge gateway whatever address it dials. ONE user, ONE database, ONE address — the alternative
# (opening the whole bridge) would let any container on this host reach any database.
hostssl  {{ pg_exporter_hba_db }}  {{ pg_exporter_hba_user }}  {{ pg_exporter_hba_source }}  scram-sha-256
{% endif %}
