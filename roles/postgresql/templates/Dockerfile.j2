# Managed by Ansible (roles/postgresql). Do not edit by hand.
# {{ pg_image }} + Patroni {{ pg_patroni_version }} from the image's own PGDG repository: same base,
# same glibc, same binaries as the standalone server — its data directory is used unchanged.
# pgBackRest (same repository) ships the WAL archive and the backups (infra/0008 decision 2).
FROM {{ pg_image }}
RUN apt-get update \
 && apt-get install -y --no-install-recommends patroni={{ pg_patroni_version }} python3-etcd \
{% if pg_pgbackrest_enabled | bool %}
      pgbackrest={{ pg_pgbackrest_version }} \
{% endif %}
 && rm -rf /var/lib/apt/lists/* \
 && patroni --version{% if pg_pgbackrest_enabled | bool %} \
 && pgbackrest version{% endif %}

USER postgres
