---
# {{ ansible_managed | default('Managed by Ansible (roles/warden)') }}
# LOCAL cold-start reconciliation — run by warden-coldstart.service on boot.
# Unseal shares are read from {{ warden_share_file }} (0600) and sent in the
# HTTPS request BODY (never argv). Vault serves the LE wildcard cert, so
# validate_certs stays true.
- name: "Warden cold-start reconciliation"
  hosts: localhost
  connection: local
  gather_facts: false
  vars:
    vault_urls: {{ warden_vault_urls | to_json }}
    share_file: "{{ warden_share_file }}"
    threshold: {{ warden_key_threshold }}
  tasks:
    # Every member of the cluster seals when it restarts: each one is asked and unsealed.
    - name: "Wait for every Vault member's API (any status incl. sealed)"
      ansible.builtin.uri:
        url: "{{ '{{' }} item {{ '}}' }}/v1/sys/health?sealedcode=503&standbycode=200"
        status_code: [200, 429, 501, 503]
      loop: "{{ '{{' }} vault_urls {{ '}}' }}"
      register: health
      retries: 60
      delay: 10
      until: health.status is defined and health.status in [200, 429, 501, 503]

    - name: "Unseal (API body — sealed members only)"
      ansible.builtin.uri:
        url: "{{ '{{' }} item.0 {{ '}}' }}/v1/sys/unseal"
        method: PUT
        body_format: json
        body:
          key: "{{ '{{' }} item.1 {{ '}}' }}"
        status_code: [200]
      loop: >-
        {{ '{{' }} health.results | selectattr('json', 'defined') | selectattr('json.sealed', 'defined')
           | selectattr('json.sealed') | selectattr('json.initialized') | map(attribute='item')
           | product((lookup('file', share_file) | from_json).shares[:threshold]) | list {{ '}}' }}
      loop_control:
        label: "{{ '{{' }} item.0 {{ '}}' }}"
      no_log: true

    - name: "Verify every member is unsealed"
      ansible.builtin.uri:
        url: "{{ '{{' }} item {{ '}}' }}/v1/sys/health?standbyok=true"
        status_code: [200, 429]
      loop: "{{ '{{' }} vault_urls {{ '}}' }}"
      register: verify
      retries: 6
      delay: 5
      until: verify.status is defined and verify.status in [200, 429]
      failed_when: false

    - name: "Platform probes"
      ansible.builtin.uri:
        url: "{{ '{{' }} item.url {{ '}}' }}"
        status_code: "{{ '{{' }} item.status {{ '}}' }}"
      loop:
{% for p in warden_probes %}
        - { name: "{{ p.name }}", url: "{{ p.url }}", status: {{ p.status | to_json }} }
{% endfor %}
      loop_control:
        label: "{{ '{{' }} item.name {{ '}}' }}"
      register: probes
      retries: 30
      delay: 10
      until: probes.status in item.status
      failed_when: false

    - name: "Summary (journal)"
      ansible.builtin.debug:
        msg: >-
          WARDEN: vault members unsealed={{ '{{' }} verify.results | selectattr('status', 'defined') | selectattr('status', 'in', [200, 429]) | list | length {{ '}}' }}/{{ '{{' }} vault_urls | length {{ '}}' }}
          probes={{ '{{' }} probes.results | selectattr('status', 'defined')
            | selectattr('status', 'in', [200, 204, 429]) | list | length {{ '}}' }}/{{ warden_probes | length }}

{% if warden_discord_webhook %}
    - name: "Notify Discord"
      ansible.builtin.uri:
        url: "{{ warden_discord_webhook }}"
        method: POST
        body_format: json
        body:
          content: "🛡️ warden: platform cold-start reconciled — Vault unsealed."
        status_code: [200, 204]
      failed_when: false
{% endif %}
