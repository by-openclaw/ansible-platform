# Managed by Ansible role `promtail`. Do not edit by hand.
server:
  disable: true

positions:
  filename: {{ promtail_positions_file }}

clients:
  - url: {{ promtail_loki_url }}

scrape_configs:
{% if promtail_ship_journal %}
  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: journal
        host: {{ inventory_hostname }}
        env: {{ promtail_env_label }}
    relabel_configs:
      - source_labels: ["__journal__systemd_unit"]
        target_label: unit
      # docker journald driver stamps CONTAINER_NAME — label container logs
      - source_labels: ["__journal_container_name"]
        target_label: container
    # infra/0006 INF-32: security streams carry the `audit` label (90-day class): sshd/PAM, sudo,
    # logins, the CrowdSec agent. Everything else in the journal stays a normal stream.
    pipeline_stages:
      - match:
          selector: '{unit=~"{{ promtail_journal_audit_units | join('|') }}"}'
          stages:
            - static_labels:
                audit: "true"
{% endif %}
{% for l in promtail_syslog_listeners | default([]) %}
  - job_name: syslog_{{ l.name }}
    syslog:
      listen_address: "0.0.0.0:{{ l.port }}"
      listen_protocol: tcp
      idle_timeout: 120s
      label_structured_data: false
      labels:
        job: {{ l.name }}
        env: {{ promtail_env_label }}
{% if l.audit | default(false) %}
        audit: "true"
{% endif %}
    relabel_configs:
      - source_labels: ["__syslog_message_hostname"]
        target_label: host
      - source_labels: ["__syslog_message_app_name"]
        target_label: app
      - source_labels: ["__syslog_message_severity"]
        target_label: severity
      - source_labels: ["__syslog_message_facility"]
        target_label: facility
{% endfor %}
{% if promtail_ship_auditd %}
{% for j in promtail_extra_file_jobs | default([]) %}
  - job_name: {{ j.name }}
    static_configs:
      - targets: [localhost]
        labels:
          job: {{ j.name }}
          host: {{ inventory_hostname }}
{% if j.audit | default(false) %}
          audit: "true"
{% endif %}
          __path__: {{ j.path }}
{% endfor %}
{% if promtail_vault_audit_log | default('') %}
  - job_name: vault_audit
    static_configs:
      - targets: [localhost]
        labels:
          job: vault_audit
          host: {{ inventory_hostname }}
          audit: "true"
          __path__: {{ promtail_vault_audit_log }}
{% endif %}
  - job_name: auditd
    static_configs:
      - targets: [localhost]
        labels:
          job: auditd
          host: {{ inventory_hostname }}
          env: {{ promtail_env_label }}
          audit: "true"
          __path__: {{ promtail_auditd_log }}
{% endif %}
