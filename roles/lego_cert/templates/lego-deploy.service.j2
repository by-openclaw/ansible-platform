# {{ ansible_managed }}
# Started by lego's --renew-hook after an actual renewal: install the new certificate
# where {{ lego_cert_id }} reads it and reload it. Steps run in order; none is a script.
[Unit]
Description=Deploy the renewed certificate into {{ lego_cert_id }}
{% if lego_cert_on_failure | bool %}
OnFailure=systemd-failure-alert@%n.service
{% endif %}

[Service]
Type=oneshot
WorkingDirectory={{ lego_cert_deploy_workdir }}
{% for step in lego_cert_deploy_steps %}
ExecStart={{ step }}
{% endfor %}
