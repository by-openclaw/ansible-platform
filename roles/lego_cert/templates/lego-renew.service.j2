# {{ ansible_managed }}
[Unit]
Description=Renew the ACME certificate for {{ lego_cert_domains | join(', ') }} (lego, {{ lego_cert_id }})
Wants=network-online.target
After=network-online.target
{% if lego_cert_on_failure | bool %}
OnFailure=systemd-failure-alert@%n.service
{% endif %}

[Service]
Type=oneshot
EnvironmentFile={{ lego_cert_dir }}/cloudflare.env
WorkingDirectory={{ lego_cert_dir }}
ExecStart={{ lego_cert_argv | join(' ') }} renew --days {{ lego_cert_renew_days }}{% if lego_cert_hook | length > 0 %} --renew-hook "{{ lego_cert_hook }}"{% endif %}
