# Managed by Ansible (role: portainer). Portainer Docker agent — this host's daemon,
# reachable from the platform supernet only (ufw). Key from Vault {{ portainer_agent_vault_path }}.
services:
  agent:
    image: {{ portainer_agent_image }}
    restart: unless-stopped
    ports:
      - "{{ hostvars[inventory_hostname].ansible_host }}:{{ portainer_agent_port }}:9001"
    environment:
      AGENT_SECRET: "{{ portainer_agent_secret }}"
      LOG_LEVEL: "INFO"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
