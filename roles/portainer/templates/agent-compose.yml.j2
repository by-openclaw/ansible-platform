# Managed by Ansible (role: portainer). Portainer agent — read/write access to THIS
# host's Docker daemon, reachable only from the platform supernet (ufw + FW catalog).
services:
  agent:
    image: {{ portainer_agent_image }}
    restart: unless-stopped
    ports:
      - "{{ hostvars[inventory_hostname].ansible_host }}:{{ portainer_agent_port }}:9001"
    environment:
      AGENT_SECRET: "{{ portainer_agent_secret }}"
      LOG_LEVEL: "INFO"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
