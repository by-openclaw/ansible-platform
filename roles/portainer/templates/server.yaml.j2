# Managed by Ansible (role: portainer). Do not edit by hand.
apiVersion: v1
kind: Namespace
metadata: { name: {{ portainer_namespace }} }
---
apiVersion: v1
kind: ServiceAccount
metadata: { name: portainer, namespace: {{ portainer_namespace }} }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: { name: portainer-cluster-admin }
roleRef: { apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: cluster-admin }
subjects: [{ kind: ServiceAccount, name: portainer, namespace: {{ portainer_namespace }} }]
---
apiVersion: v1
kind: Secret
metadata: { name: portainer-admin, namespace: {{ portainer_namespace }} }
type: Opaque
stringData:
  # Portainer locks itself if no admin is created shortly after first start: the
  # password is declared here (from Vault), never typed into the first-run wizard.
  password: "{{ portainer_admin_password }}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: portainer-data, namespace: {{ portainer_namespace }} }
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources: { requests: { storage: {{ portainer_storage_size }} } }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: portainer, namespace: {{ portainer_namespace }}, labels: { app: portainer } }
spec:
  replicas: 1
  strategy: { type: Recreate }        # one PVC, no rolling update
  selector: { matchLabels: { app: portainer } }
  template:
    metadata: { labels: { app: portainer } }
    spec:
      serviceAccountName: portainer
      containers:
        - name: portainer
          image: {{ portainer_server_image }}
          args:
            - "--http-enabled"                       # TLS terminates on the platform Traefik
            - "--base-url=/"
            - "--admin-password-file=/run/portainer/password"
          ports: [{ containerPort: 9000, name: http }]
          volumeMounts:
            - { name: data, mountPath: /data }
            - { name: admin, mountPath: /run/portainer, readOnly: true }
          readinessProbe: { httpGet: { path: /api/status, port: 9000 }, periodSeconds: 10 }
          livenessProbe: { httpGet: { path: /api/status, port: 9000 }, initialDelaySeconds: 60, periodSeconds: 30 }
          resources: { requests: { cpu: 50m, memory: 128Mi }, limits: { memory: 512Mi } }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: portainer-data }
        - name: admin
          secret: { secretName: portainer-admin, items: [{ key: password, path: password }] }
---
apiVersion: v1
kind: Service
metadata: { name: portainer, namespace: {{ portainer_namespace }} }
spec:
  selector: { app: portainer }
  ports: [{ name: http, port: 80, targetPort: 9000 }]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata: { name: portainer, namespace: {{ portainer_namespace }} }
spec:
  ingressClassName: traefik
  rules:
    - host: {{ portainer_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend: { service: { name: portainer, port: { number: 80 } } }
