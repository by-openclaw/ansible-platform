# Managed by Ansible (role: portainer). Portainer Kubernetes agent — lets the console
# on lxc-portainer-01 manage this cluster. The console itself does NOT run here.
apiVersion: v1
kind: Namespace
metadata: { name: {{ portainer_k8s_namespace }} }
---
apiVersion: v1
kind: ServiceAccount
metadata: { name: portainer-agent, namespace: {{ portainer_k8s_namespace }} }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: { name: portainer-agent-cluster-admin }
roleRef: { apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: cluster-admin }
subjects: [{ kind: ServiceAccount, name: portainer-agent, namespace: {{ portainer_k8s_namespace }} }]
---
apiVersion: v1
kind: Secret
metadata: { name: portainer-agent, namespace: {{ portainer_k8s_namespace }} }
type: Opaque
stringData: { AGENT_SECRET: "{{ portainer_agent_secret }}" }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: portainer-agent, namespace: {{ portainer_k8s_namespace }} }
spec:
  replicas: 1
  selector: { matchLabels: { app: portainer-agent } }
  template:
    metadata: { labels: { app: portainer-agent } }
    spec:
      serviceAccountName: portainer-agent
      containers:
        - name: portainer-agent
          image: {{ portainer_agent_image }}
          env:
            - { name: LOG_LEVEL, value: INFO }
            - { name: AGENT_CLUSTER_ADDR, value: "portainer-agent-headless" }
            - { name: KUBERNETES_POD_IP, valueFrom: { fieldRef: { fieldPath: status.podIP } } }
            - { name: AGENT_SECRET, valueFrom: { secretKeyRef: { name: portainer-agent, key: AGENT_SECRET } } }
          ports: [{ containerPort: 9001, protocol: TCP }]
          resources: { requests: { cpu: 20m, memory: 64Mi }, limits: { memory: 256Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: portainer-agent, namespace: {{ portainer_k8s_namespace }} }
spec:
  type: NodePort
  selector: { app: portainer-agent }
  ports: [{ name: http, protocol: TCP, port: 9001, targetPort: 9001, nodePort: {{ portainer_k8s_agent_nodeport }} }]
---
apiVersion: v1
kind: Service
metadata: { name: portainer-agent-headless, namespace: {{ portainer_k8s_namespace }} }
spec:
  clusterIP: None
  selector: { app: portainer-agent }
