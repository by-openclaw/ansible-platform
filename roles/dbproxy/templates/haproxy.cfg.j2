# Managed by Ansible (roles/dbproxy). Do not edit by hand.
global
    log stdout format raw local0 info
    maxconn {{ dbproxy_maxconn }}
    hard-stop-after {{ dbproxy_hard_stop_after }}

defaults
    log     global
    mode    tcp
    option  tcplog
    option  clitcpka
    option  srvtcpka
    retries 2
    timeout connect {{ dbproxy_connect_timeout }}
    timeout client  {{ dbproxy_idle_timeout }}
    timeout server  {{ dbproxy_idle_timeout }}
    timeout check   {{ dbproxy_check_timeout }}

# Member names are resolved through the guest's resolver, at start and while running.
resolvers platform
    parse-resolv-conf
    hold valid 30s

{% if dbproxy_pg_members | length > 0 %}
# PostgreSQL: the ONE member whose Patroni answers 200 on /primary. The check speaks HTTPS to
# the member's REST API and verifies its certificate; the data path is plain TCP (the client's
# TLS session ends on PostgreSQL).
listen postgres
    bind :::{{ dbproxy_pg_port }} v4v6
    option httpchk
    http-check send meth GET uri /primary
    http-check expect status 200
    default-server inter {{ dbproxy_check_interval }} fall {{ dbproxy_check_fall }} rise {{ dbproxy_check_rise }} on-marked-down shutdown-sessions check port {{ dbproxy_patroni_port }} check-ssl verify required ca-file {{ dbproxy_ca_bundle }} resolvers platform init-addr last,libc,none
{% for h in dbproxy_pg_members %}
    server {{ h }} {{ h }}.{{ platform_domain }}:{{ dbproxy_pg_port }} check-sni {{ h }}.{{ platform_domain }} verifyhost {{ h }}.{{ platform_domain }}
{% endfor %}

{% endif %}
{% if dbproxy_redis_members | length > 0 %}
# Redis, part 1 — what the Sentinels say. One backend per member, whose "servers" are the
# Sentinels: a Sentinel is UP in the backend of member M while it names M as the primary.
# No traffic goes through these backends; the route below counts their servers.
# (No QUIT at the end: a Sentinel does not answer it for a restricted login, and the check
# then times out — which made the endpoint refuse Redis for 3 min 40 s on 2026-10-04.)
{% for m in dbproxy_redis_members %}
backend redis_named_{{ m }}
    option tcp-check
    tcp-check send "AUTH {{ dbproxy_redis_check_user }} {{ dbproxy_redis_check_password }}\r\n"
    tcp-check expect string +OK
    tcp-check send "SENTINEL get-master-addr-by-name {{ dbproxy_redis_master_name }}\r\n"
    tcp-check expect string {{ m }}.{{ platform_domain }}
    default-server init-state fully-down inter {{ dbproxy_check_interval }} fall {{ dbproxy_redis_check_fall }} rise {{ dbproxy_redis_check_rise }} check check-ssl verify required ca-file {{ dbproxy_ca_bundle }} resolvers platform init-addr last,libc,none
{% for s in dbproxy_redis_sentinels %}
    server {{ s }} {{ s }}.{{ platform_domain }}:{{ dbproxy_redis_sentinel_port }} check-sni {{ s }}.{{ platform_domain }} verifyhost {{ s }}.{{ platform_domain }}
{% endfor %}

{% endfor %}
# Redis, part 2 — the route. A member is ELIGIBLE while it answers role:master (its own check:
# TLS, its own login, INFO replication) AND {{ dbproxy_redis_sentinel_quorum }} Sentinels name it. A member that says master
# without the Sentinels' word (a restarted or resumed old primary) gets nothing.
#   * no member eligible  -> the connection is refused, never sent elsewhere;
#   * two eligible at once (the Sentinels' word about a former primary is not withdrawn here yet
#     and it is back, claiming to be a master) -> refused too: the endpoint does not guess.
# What the endpoint remembers about a member that is no longer named must not block the one
# that is: until 2026-10-04 it did, for the 2 x check timeout it takes to forget — 3.7 s of a
# measured 9.7 s. Every state starts as "down" (init-state): nothing is routed before a check
# has answered. The data path is plain TCP (the client's TLS session ends on Redis).
listen redis
    bind :::{{ dbproxy_redis_port }} v4v6
    option tcp-check
    tcp-check send "AUTH {{ dbproxy_redis_check_user }} {{ dbproxy_redis_check_password }}\r\n"
    tcp-check expect string +OK
    tcp-check send "INFO replication\r\n"
    tcp-check expect rstring role:master\r
    tcp-check send "QUIT\r\n"
    tcp-check expect string +OK
{% for m in dbproxy_redis_members %}
    acl named_{{ loop.index }} nbsrv(redis_named_{{ m }}) ge {{ dbproxy_redis_sentinel_quorum }}
    acl up_{{ loop.index }} srv_is_up(redis/{{ m }})
{% endfor %}
    tcp-request content reject unless {% for m in dbproxy_redis_members %}named_{{ loop.index }} up_{{ loop.index }}{{ ' or ' if not loop.last }}{% endfor %}

{% for a in range(1, dbproxy_redis_members | length + 1) %}
{% for b in range(a + 1, dbproxy_redis_members | length + 1) %}
    tcp-request content reject if named_{{ a }} up_{{ a }} named_{{ b }} up_{{ b }}
{% endfor %}
{% endfor %}
{% for m in dbproxy_redis_members %}
    use-server {{ m }} if named_{{ loop.index }} up_{{ loop.index }}
{% endfor %}
    default-server init-state fully-down inter {{ dbproxy_check_interval }} fall {{ dbproxy_redis_check_fall }} rise {{ dbproxy_redis_check_rise }} on-marked-down shutdown-sessions check check-ssl verify required ca-file {{ dbproxy_ca_bundle }} resolvers platform init-addr last,libc,none
{% for h in dbproxy_redis_members %}
    server {{ h }} {{ h }}.{{ platform_domain }}:{{ dbproxy_redis_port }} check-sni {{ h }}.{{ platform_domain }} verifyhost {{ h }}.{{ platform_domain }}
{% endfor %}

{% endif %}
frontend metrics
    bind :::{{ dbproxy_metrics_port }} v4v6
    mode http
    no log
    http-request use-service prometheus-exporter if { path /metrics }
    http-request deny
