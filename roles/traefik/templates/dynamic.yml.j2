{# Traefik v3 dynamic config — managed by Ansible role `traefik`. Do not edit by hand. #}
tls:
  options:
    default:
      # Minimum TLS 1.2 for EVERY router (Traefik applies `default` to any router
      # that doesn't name its own options) — every service URL inherits this.
      minVersion: {{ traefik_tls_min_version }}
  stores:
    default:
      defaultCertificate:
        certFile: {{ traefik_cert_crt }}
        keyFile: {{ traefik_cert_key }}
  certificates:
    - certFile: {{ traefik_cert_crt }}
      keyFile: {{ traefik_cert_key }}

http:
  middlewares:
    internal-only:
      # Dashboard is reachable only from internal networks (split-horizon).
      ipAllowList:
        sourceRange:
{% for cidr in traefik_internal_cidrs %}
          - "{{ cidr }}"
{% endfor %}
{# break-glass admin desks (OOB), the same list every internal route appends #}
{% for cidr in traefik_admin_cidrs | default([]) %}
          - "{{ cidr }}"
{% endfor %}

    # HSTS — applied to EVERY service via the websecure entrypoint (Traefik
    # terminates TLS, so the backends never see HTTPS and cannot emit it). This
    # clears Nextcloud's "Strict-Transport-Security not set" setup-check and
    # hardens every *.{{ traefik_domain }} app.
    hsts:
      headers:
        stsSeconds: {{ traefik_hsts_seconds }}
        stsIncludeSubdomains: {{ traefik_hsts_include_subdomains | lower }}
        stsPreload: {{ traefik_hsts_preload | lower }}
        contentTypeNosniff: {{ traefik_headers_nosniff | lower }}
        referrerPolicy: "{{ traefik_headers_referrer_policy }}"

{% if traefik_crowdsec_enabled | default(false) %}
    # CrowdSec bouncer — queries the central LAPI for the client IP's decision
    # and returns 403 for banned IPs. stream mode caches the decision list; a LAPI
    # absence of up to updateMaxFailure polls keeps serving from that cache, longer
    # than that the gate closes (403). Key read from a 0600 file, not inline.
    crowdsec:
      plugin:
        bouncer:
          enabled: "true"
          crowdsecMode: {{ traefik_crowdsec_mode }}
          updateMaxFailure: {{ traefik_crowdsec_update_max_failure }}
          crowdsecLapiScheme: {{ traefik_crowdsec_lapi_scheme }}
          crowdsecLapiHost: {{ traefik_crowdsec_lapi_host }}
          crowdsecLapiKeyFile: {{ traefik_crowdsec_keyfile }}
{% endif %}

    # Authentik forwardAuth → embedded outpost. Unauthenticated requests get a 302
    # to Authentik (SSO); after login the user must be in traefik-admins (bound to
    # the proxy app at the IdP) or the outpost returns 403. Identity headers are
    # copied back onto the request (harmless for api@internal; standard for the app).
    authentik:
      forwardAuth:
        address: "http://127.0.0.1:{{ traefik_authgate_port }}/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
{% for h in traefik_authentik_auth_headers %}
          - "{{ h }}"
{% endfor %}

  services:
    # Authentik embedded outpost — serves the forwardAuth check AND the
    # /outpost.goauthentik.io/ login-callback + static assets on the dashboard host.
    authentik-outpost:
      loadBalancer:
        servers:
{% for u in traefik_authentik_outpost_urls %}
          - url: "{{ u }}"
{% endfor %}
        healthCheck:
          path: "{{ traefik_authentik_health_path }}"
          interval: "5s"
          timeout: "3s"

  routers:
    # The forwardAuth gate (loopback entry point): the edge's own auth requests, balanced
    # over the Authentik instances that are ready.
    authentik-authgate:
      rule: "PathPrefix(`/outpost.goauthentik.io/`)"
      entryPoints:
        - authgate
      service: authentik-outpost

    # Traefik dashboard — internal network AND Authentik SSO (traefik-admins).
    dashboard:
      rule: "Host(`{{ traefik_dashboard_host }}`)"
      entryPoints:
        - websecure
      service: api@internal
      middlewares:
        - internal-only
        - authentik
      tls: {}

    # Authentik outpost endpoints on the dashboard host (login callback + assets).
    # MUST NOT carry the `authentik` middleware (it IS the auth flow) — only the
    # internal-network gate. Higher priority so it wins over the catch-all dashboard
    # rule for the /outpost.goauthentik.io/ path.
    dashboard-outpost:
      rule: "Host(`{{ traefik_dashboard_host }}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      priority: 100
      entryPoints:
        - websecure
      service: authentik-outpost
      middlewares:
        - internal-only
      tls: {}

  # Backend service routers (postgres-adjacent UIs, authentik, netbox, …) are
  # added here as each cluster service comes up. Example shape:
  #   routers:
  #     netbox:
  #       rule: "Host(`netbox.{{ traefik_domain }}`)"
  #       entryPoints: [websecure]
  #       service: netbox
  #       tls: {}
  #   services:
  #     netbox:
  #       loadBalancer:
  #         servers:
  #           - url: "http://10.1.3.120:8080"
