{# Traefik v3 static config — managed by Ansible role `traefik`. Do not edit by hand. #}
global:
  checkNewVersion: false
  sendAnonymousUsage: false

# Entry points bind ":80"/":443" → dual-stack (IPv4 + IPv6) by default.
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      # HSTS on every HTTPS response (middleware defined in the file provider).
      middlewares:
        - hsts@file
{% if traefik_crowdsec_enabled | default(false) %}
        # CrowdSec L7 bouncer — blocks IPs with an active decision before any app.
        - crowdsec@file
{% endif %}
    # Long-lived gRPC + WebSocket streams (NetBird management/signal/relay) require
    # the responding timeouts disabled — mirrors the official NetBird reverse-proxy
    # guide (readTimeout/writeTimeout/idleTimeout = 0). Harmless for the other apps.
    transport:
      respondingTimeouts:
        readTimeout: "0s"
        writeTimeout: "0s"
        idleTimeout: "0s"

api:
  dashboard: true

providers:
  file:
    directory: {{ traefik_dynamic_dir }}
    watch: true

log:
  level: INFO
  filePath: {{ traefik_log_dir }}/traefik.log

accessLog:
  filePath: {{ traefik_log_dir }}/access.log

{% if traefik_crowdsec_enabled | default(false) %}
# CrowdSec bouncer plugin — downloaded from GitHub at startup (Yaegi). The
# middleware itself is defined in the file provider (dynamic.yml).
experimental:
  plugins:
    bouncer:
      moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      version: {{ traefik_crowdsec_plugin_version }}
{% endif %}
