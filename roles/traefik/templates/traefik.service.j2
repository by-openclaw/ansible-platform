{# systemd unit — managed by Ansible role `traefik`. Do not edit by hand. #}
[Unit]
Description=Traefik reverse proxy / HTTPS ingress
Documentation=https://doc.traefik.io/traefik/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ traefik_bin }} --configFile={{ traefik_conf_dir }}/traefik.yml
Restart=on-failure
RestartSec=5
# Runs as root: binds privileged :80/:443 and reads the root-owned lego cert.
# Hardening to a dedicated non-root user + CAP_NET_BIND_SERVICE + cert group
# read is a tracked follow-up (dedicated isolated LXC mitigates for now).
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
