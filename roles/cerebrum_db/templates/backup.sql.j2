-- nightly full backup of each Cerebrum database (roles/cerebrum_db): one file per database and weekday,
-- overwritten each week, verified by checksum; the guest backup carries the folder off the host.
SET NOCOUNT ON;
DECLARE @file nvarchar(400);
{% for db in cerebrum_db_databases %}
IF DB_ID(N'{{ db }}') IS NOT NULL
BEGIN
    SET @file = N'{{ cerebrum_db_backup_dir }}\{{ db }}_' + DATENAME(weekday, GETDATE()) + N'.bak';
    BACKUP DATABASE [{{ db }}] TO DISK = @file WITH INIT, CHECKSUM, STATS = 25;
    RESTORE VERIFYONLY FROM DISK = @file WITH CHECKSUM;
END
ELSE
    PRINT 'no database {{ db }} yet: Cerebrum creates it at first start';
{% endfor %}
