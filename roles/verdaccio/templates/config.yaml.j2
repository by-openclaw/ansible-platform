# Managed by Ansible (roles/verdaccio). npm registry + upstream proxy.
storage: /verdaccio/storage
web:
  title: BY-SYSTEMS npm
  gravatar: false
auth:
  htpasswd:
    file: /verdaccio/conf/htpasswd
    # max_users default: existing htpasswd users can log in (get tokens). Hard
    # access-gating (Authentik groups) arrives with the verdaccio-openid plugin
    # follow-up; today the registry is VPN-only and every package is
    # $authenticated, so only htpasswd-known users reach anything.
    max_users: 1000
uplinks:
  npmjs:
    url: {{ verdaccio_uplink_url }}
    cache: true
    maxage: 30m
packages:
  '{{ verdaccio_scope }}/*':
    access: $authenticated
    publish: $authenticated
    unpublish: $authenticated
    # own scope — NOT proxied upstream
  '**':
    access: $authenticated
    publish: $authenticated
    unpublish: $authenticated
    proxy: npmjs
server:
  keepAliveTimeout: 60
middlewares:
  audit:
    enabled: true
log: { type: stdout, format: pretty, level: http }
listen: 0.0.0.0:4873
url_prefix: https://{{ verdaccio_fqdn }}/
