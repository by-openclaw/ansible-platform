# WireGuard client config — {{ item.name }}
# Tunnel: {{ opnsense_wireguard_instance_name }}
# Generated by Ansible — do not edit manually
# Import into WireGuard app or place at /etc/wireguard/{{ opnsense_wireguard_instance_name }}.conf

[Interface]
{% if item.name == 'peer-rune-vm' %}
PrivateKey = {{ vault_opnsense_wg_peer_rune_privkey }}
{% else %}
PrivateKey = <PASTE_YOUR_PRIVATE_KEY_HERE>
{% endif %}
Address = {{ item.tunnel_ip }}
DNS = {{ opnsense_wireguard_server_ip }}

[Peer]
PublicKey = {{ opnsense_wireguard_public_key }}
Endpoint = {{ opnsense_wan_ip }}:{{ opnsense_wireguard_port }}
AllowedIPs = {{ opnsense_wireguard_tunnel_network }}, 10.1.0.0/20
PersistentKeepalive = 25
