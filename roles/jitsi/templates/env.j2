# Managed by Ansible (roles/jitsi). Official docker-jitsi-meet .env — secrets from Vault.
CONFIG={{ jitsi_config_dir }}
TZ={{ jitsi_tz }}
PUBLIC_URL=https://{{ jitsi_fqdn }}
# Traefik terminates TLS; the web container serves HTTP on the loopback only.
HTTP_PORT={{ jitsi_http_port }}
HTTPS_PORT=8443
DISABLE_HTTPS=1
ENABLE_LETSENCRYPT=0
ENABLE_HTTP_REDIRECT=0
ENABLE_HSTS=0
# JVB media
JVB_PORT={{ jitsi_jvb_port }}
{% if jitsi_advertise_ips | length > 0 %}
JVB_ADVERTISE_IPS={{ jitsi_advertise_ips }}
{% endif %}
# Internal component secrets (Vault {{ jitsi_vault_path }})
JICOFO_COMPONENT_SECRET={{ jitsi_secrets.jicofo_component_secret }}
JICOFO_AUTH_PASSWORD={{ jitsi_secrets.jicofo_auth_password }}
JVB_AUTH_PASSWORD={{ jitsi_secrets.jvb_auth_password }}
JIGASI_XMPP_PASSWORD={{ jitsi_secrets.jigasi_xmpp_password }}
JIBRI_RECORDER_PASSWORD={{ jitsi_secrets.jibri_recorder_password }}
JIBRI_XMPP_PASSWORD={{ jitsi_secrets.jibri_xmpp_password }}
# XMPP domains (defaults)
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
JVB_BREWERY_MUC=jvbbrewery
RESTART_POLICY=unless-stopped
