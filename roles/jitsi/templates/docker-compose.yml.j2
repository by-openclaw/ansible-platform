# Managed by Ansible (roles/jitsi). Official jitsi/docker-jitsi-meet stack, pinned.
services:
  web:
    image: {{ jitsi_image_repo }}/web:{{ jitsi_image_tag }}
    restart: {{ jitsi_restart_policy }}
    logging: {driver: journald}   # explicit: a container keeps the driver it was created with
    ports:
      - "{{ jitsi_http_ip }}:{{ jitsi_http_port }}:8000"   # stable-11146: unprivileged 8000/8443
    volumes:   # as the vendor's compose (stable-11248-3)
      - "{{ jitsi_config_dir }}/web:/config:Z"
      - "{{ jitsi_config_dir }}/storage/web:/storage:Z"
      - "{{ jitsi_config_dir }}/web/custom-ca:/usr/local/share/ca-certificates:ro,z"
      - "{{ jitsi_config_dir }}/storage/transcripts:/usr/share/jitsi-meet/transcripts:ro,z"
      - "{{ jitsi_config_dir }}/tmp/web-load-test:/usr/share/jitsi-meet/load-test:Z"
    environment: &jitsi_env
      - CONFIG={{ jitsi_config_dir }}
    env_file: [.env]
    depends_on: [prosody]
    networks: {meet.jitsi: {}}
  prosody:
    image: {{ jitsi_image_repo }}/prosody:{{ jitsi_image_tag }}
    restart: {{ jitsi_restart_policy }}
    logging: {driver: journald}   # explicit: a container keeps the driver it was created with
    expose: ["5222", "5347", "5280"]
    volumes:
      - "{{ jitsi_config_dir }}/prosody/config:/config:Z"
      - "{{ jitsi_config_dir }}/prosody/prosody-plugins-custom:/prosody-plugins-custom:Z"
      - "{{ jitsi_config_dir }}/storage/prosody:/var/lib/prosody:Z"
      - "{{ jitsi_config_dir }}/prosody/custom-ca:/usr/local/share/ca-certificates:ro,z"
    env_file: [.env]
    networks: {meet.jitsi: {aliases: [xmpp.meet.jitsi]}}
  jicofo:
    image: {{ jitsi_image_repo }}/jicofo:{{ jitsi_image_tag }}
    restart: {{ jitsi_restart_policy }}
    logging: {driver: journald}   # explicit: a container keeps the driver it was created with
    volumes:
      - "{{ jitsi_config_dir }}/jicofo:/config:Z"
      - "{{ jitsi_config_dir }}/jicofo/custom-ca:/usr/local/share/ca-certificates:ro,z"
    env_file: [.env]
    depends_on: [prosody]
    networks: {meet.jitsi: {}}
  jvb:
    image: {{ jitsi_image_repo }}/jvb:{{ jitsi_image_tag }}
    restart: {{ jitsi_restart_policy }}
    logging: {driver: journald}   # explicit: a container keeps the driver it was created with
    ports:
      - "{{ jitsi_jvb_port }}:{{ jitsi_jvb_port }}/udp"
      # JVB private REST API (/metrics in Prometheus format) — host address only, admitted to the
      # monitoring host by the DOCKER-USER catalog (group_vars/all/docker_firewall.yml)
      - "{{ jitsi_http_ip }}:{{ jitsi_metrics_port }}:8080"
    volumes:
      - "{{ jitsi_config_dir }}/jvb:/config:Z"
      - "{{ jitsi_config_dir }}/jvb/custom-ca:/usr/local/share/ca-certificates:ro,z"
    env_file: [.env]
    depends_on: [prosody]
    networks: {meet.jitsi: {}}
networks:
  meet.jitsi:
    driver: bridge
