# Managed by Ansible role `vault_deploy_identity`. The controller's deploy
# identity — everything the Ansible run needs, WITHOUT being root (no seal,
# rekey, root-token, or audit-device control). Replaces the root token (SEC-06).

# Service secrets (KV v2): full CRUD under {env}, plus archive.
{% for _env in (vdi_envs | default([vdi_env])) %}
path "{{ vdi_mount }}/data/{{ _env }}/*"     { capabilities = ["create","read","update","delete","list"] }
path "{{ vdi_mount }}/metadata/{{ _env }}/*" { capabilities = ["create","read","update","delete","list"] }
{% endfor %}
path "{{ vdi_mount }}/data/archive/*"           { capabilities = ["create","read","update","list"] }
path "{{ vdi_mount }}/metadata/archive/*"       { capabilities = ["read","list","delete"] }
path "{{ vdi_mount }}/metadata"                 { capabilities = ["list"] }
{% for _env in (vdi_envs | default([vdi_env])) %}
path "{{ vdi_mount }}/metadata/{{ _env }}"   { capabilities = ["list"] }
{% endfor %}

# Manage per-service policies + AppRoles (the vault_policy role).
path "sys/policies/acl/*"                        { capabilities = ["create","read","update","delete","list"] }
path "auth/approle/role/*"                       { capabilities = ["create","read","update","delete","list"] }
# SEC-07: manage audit devices (enable/list the file audit log) — deliberately
# NO delete on sys/audit so a compromised deploy identity cannot silence auditing.
path "sys/audit"                                 { capabilities = ["read","list","sudo"] }
path "sys/audit/*"                               { capabilities = ["create","read","update","list","sudo"] }

# Read-only introspection the deploy path uses.
path "sys/auth"                                  { capabilities = ["read"] }
path "sys/auth/approle"                          { capabilities = ["read","sudo"] }
path "sys/mounts"                                { capabilities = ["read"] }

# Raft snapshot for the backup playbook (data path, not root-only config).
path "sys/storage/raft/snapshot"                 { capabilities = ["read"] }
