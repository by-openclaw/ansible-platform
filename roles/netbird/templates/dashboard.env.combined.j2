# {{ ansible_managed }}
# Combined-architecture dashboard config, matching NetBird's own installer.
# The authority is the SERVER's embedded IdP at /oauth2 — NOT Authentik.
# Authentik is added afterwards as an external provider inside the dashboard,
# which is how the combined model does SSO.
NETBIRD_MGMT_API_ENDPOINT=https://{{ netbird_fqdn }}
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://{{ netbird_fqdn }}
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=https://{{ netbird_fqdn }}/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
NETBIRD_TOKEN_SOURCE=accessToken
LETSENCRYPT_DOMAIN=none
