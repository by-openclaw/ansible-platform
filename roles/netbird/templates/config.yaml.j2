# Combined NetBird Server Configuration
# Managed by Ansible (role: netbird) — mirrors the official getting-started.sh output.

server:
  listenAddress: ":{{ netbird_http_port }}"
  exposedAddress: "{{ netbird_http_protocol }}://{{ netbird_fqdn }}:{{ netbird_public_port }}"
  stunPorts:
    - {{ netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "{{ netbird_secrets.relay_auth_secret }}"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "{{ netbird_oauth2_issuer }}"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
{% for uri in netbird_dashboard_redirect_uris %}
      - "{{ uri }}"
{% endfor %}
    cliRedirectURIs:
{% for uri in netbird_cli_redirect_uris %}
      - "{{ uri }}"
{% endfor %}

  reverseProxy:
    trustedHTTPProxies:
      - "{{ netbird_traefik_ip }}/32"

  store:
    engine: "{{ netbird_store_engine }}"
    encryptionKey: "{{ netbird_secrets.datastore_enc_key }}"
