{# Managed by Ansible role `netbird`. Do not edit by hand.
   Dashboard env — verbatim from getting-started.sh render_dashboard_env. The
   dashboard authenticates against the EMBEDDED Dex IdP (static client
   `netbird-dashboard`, no secret); Authentik is federated upstream of Dex. #}
# Endpoints
NETBIRD_MGMT_API_ENDPOINT={{ netbird_http_protocol }}://{{ netbird_fqdn }}
NETBIRD_MGMT_GRPC_API_ENDPOINT={{ netbird_http_protocol }}://{{ netbird_fqdn }}
# OIDC - using embedded IdP (Dex)
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY={{ netbird_oauth2_issuer }}
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
# SSL
NGINX_SSL_PORT=443
# Letsencrypt (TLS handled by our Traefik)
LETSENCRYPT_DOMAIN=none
