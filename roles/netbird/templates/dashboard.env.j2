{# Managed by Ansible role `netbird`. Do NOT edit by hand.
   Dashboard env — verbatim mapping of the official Traefik compose `dashboard`
   environment. The SPA sends the browser STRAIGHT to Authentik to log in (no Dex):
   AUTH_AUTHORITY is the Authentik application issuer; the browser resolves it via
   public DNS. TLS is terminated by our Traefik, so the dashboard nginx serves :80. #}
# Endpoints (management API, reached through our Traefik on :443)
NETBIRD_MGMT_API_ENDPOINT={{ netbird_http_protocol }}://{{ netbird_fqdn }}
NETBIRD_MGMT_GRPC_API_ENDPOINT={{ netbird_http_protocol }}://{{ netbird_fqdn }}
# OIDC — Authentik direct
AUTH_AUDIENCE={{ netbird_oidc.client_id }}
AUTH_CLIENT_ID={{ netbird_oidc.client_id }}
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY={{ netbird_oidc_issuer }}
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES={{ netbird_auth_supported_scopes }}
AUTH_REDIRECT_URI={{ netbird_auth_redirect_uri }}
AUTH_SILENT_REDIRECT_URI={{ netbird_auth_silent_redirect_uri }}
NETBIRD_TOKEN_SOURCE=accessToken
# SSL (Traefik fronts TLS; dashboard nginx serves plain :80)
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
