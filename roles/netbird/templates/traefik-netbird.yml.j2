{# Managed by Ansible role `netbird` (delegated to the Traefik host). Do NOT edit.
   File-provider translation of NetBird's OFFICIAL multi-container Traefik labels
   (infrastructure_files/docker-compose.yml.tmpl.traefik). Our Traefik runs on a
   separate host and reaches each container by its published port on the SVC IP.
   gRPC routers use the h2c scheme. PUBLIC — NO ipAllowList: remote peers must
   reach /api, the gRPC services, /relay from the internet (the WAN DNAT forwards
   :443 here). There is NO /oauth2 route — login goes straight to Authentik. #}
http:
  routers:
    # --- gRPC (h2c backends) ----------------------------------------------------
    netbird-mgmt-grpc:
      rule: "Host(`{{ netbird_fqdn }}`) && (PathPrefix(`/management.ManagementService/`) || PathPrefix(`/management.ProxyService/`))"
      entryPoints: [websecure]
      service: netbird-mgmt-h2c
      priority: 100
      tls: {}
    netbird-signal-grpc:
      rule: "Host(`{{ netbird_fqdn }}`) && PathPrefix(`/signalexchange.SignalExchange/`)"
      entryPoints: [websecure]
      service: netbird-signal-h2c
      priority: 100
      tls: {}
    # --- REST / WebSocket backends ----------------------------------------------
    netbird-api:
      rule: "Host(`{{ netbird_fqdn }}`) && (PathPrefix(`/api`) || PathPrefix(`/ws-proxy/management`))"
      entryPoints: [websecure]
      service: netbird-mgmt
      priority: 90
      tls: {}
    netbird-signal-ws:
      rule: "Host(`{{ netbird_fqdn }}`) && PathPrefix(`/ws-proxy/signal`)"
      entryPoints: [websecure]
      service: netbird-signal-ws
      priority: 90
      tls: {}
    netbird-relay:
      rule: "Host(`{{ netbird_fqdn }}`) && PathPrefix(`/relay`)"
      entryPoints: [websecure]
      service: netbird-relay
      priority: 90
      tls: {}
    # --- Dashboard catch-all (lowest priority, per the official label) ----------
    netbird-dashboard:
      rule: "Host(`{{ netbird_fqdn }}`)"
      entryPoints: [websecure]
      service: netbird-dashboard
      priority: 1
      tls: {}

  services:
    netbird-mgmt:
      loadBalancer:
        servers:
          - url: "http://{{ netbird_listen_ip }}:{{ netbird_mgmt_port }}"
    netbird-mgmt-h2c:
      loadBalancer:
        servers:
          - url: "h2c://{{ netbird_listen_ip }}:{{ netbird_mgmt_port }}"
    netbird-signal-ws:
      loadBalancer:
        servers:
          - url: "http://{{ netbird_listen_ip }}:{{ netbird_signal_ws_host_port }}"
    netbird-signal-h2c:
      loadBalancer:
        servers:
          - url: "h2c://{{ netbird_listen_ip }}:{{ netbird_signal_grpc_port }}"
    netbird-relay:
      loadBalancer:
        servers:
          - url: "http://{{ netbird_listen_ip }}:{{ netbird_relay_port }}"
    netbird-dashboard:
      loadBalancer:
        servers:
          - url: "http://{{ netbird_listen_ip }}:{{ netbird_dashboard_port }}"
