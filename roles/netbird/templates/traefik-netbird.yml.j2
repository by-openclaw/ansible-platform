{# Managed by Ansible role `netbird` (delegated to the Traefik host). Do NOT edit.
   COMBINED architecture: management, signal, relay and STUN are ONE process on a
   single port, so every backend path targets the same server. The previous
   version pointed signal/relay at the old per-container ports (:10000, :8081,
   :33080), which no longer exist — peers could enrol but never complete the
   control-plane connection.
   Mirrors NetBird's own labels: gRPC via h2c, /oauth2 to the server's embedded
   IdP, dashboard as the lowest-priority catch-all. PUBLIC — no ipAllowList:
   remote peers must reach these from the internet. #}
http:
  routers:
    # gRPC — management AND signal, both on the combined server (h2c).
    netbird-grpc:
      rule: "Host(`{{ netbird_fqdn }}`) && (PathPrefix(`/management.ManagementService/`) || PathPrefix(`/management.ProxyService/`) || PathPrefix(`/signalexchange.SignalExchange/`))"
      entryPoints: [websecure]
      service: netbird-server-h2c
      priority: 100
      tls: {}

    # REST, websocket proxy, relay and the embedded IdP — same server.
    netbird-backend:
      rule: "Host(`{{ netbird_fqdn }}`) && (PathPrefix(`/api`) || PathPrefix(`/oauth2`) || PathPrefix(`/relay`) || PathPrefix(`/ws-proxy/`))"
      entryPoints: [websecure]
      service: netbird-server
      priority: 90
      tls: {}

    # Dashboard catch-all (lowest priority, per the official label).
    netbird-dashboard:
      rule: "Host(`{{ netbird_fqdn }}`)"
      entryPoints: [websecure]
      service: netbird-dashboard
      priority: 1
      tls: {}

  services:
    netbird-server:
      loadBalancer:
        servers:
          - url: "http://{{ netbird_listen_ip }}:{{ netbird_server_port }}"
    netbird-server-h2c:
      loadBalancer:
        servers:
          - url: "h2c://{{ netbird_listen_ip }}:{{ netbird_server_port }}"
    netbird-dashboard:
      loadBalancer:
        servers:
          - url: "http://{{ netbird_listen_ip }}:80"
