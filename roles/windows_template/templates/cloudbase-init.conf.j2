# Managed by Ansible (roles/windows_template): cloudbase-init on every clone reads the Proxmox
# cloud-init drive (configdrive) — hostname, static addresses. Never the administrator's password:
# roles/windows_guest sets it from Vault (platform_windows_cloudbase_plugins, group_vars/all/windows.yml).
[DEFAULT]
username=Administrator
groups=Administrators
# cloudbase-init never sets the password (false, and no SetUserPasswordPlugin). NOTHING may follow the value:
# oslo.config does not strip inline comments — "true  # ..." fails the boolean parse and
# the service dies on start (exit 1067) before it even opens its log (seen live 2026-10-14).
# A boolean option name, no secret. Nothing Jinja may share the value's line: Ansible
# templates with trim_blocks, and an inline {# comment #} eats the newline — the next
# option gets GLUED onto the value (2026-10-14, second broken template from this line).
# pragma: allowlist nextline secret
inject_user_password=false
first_logon_behaviour=no
rename_admin_user=false
config_drive_types=vfat,iso
config_drive_locations=cdrom,hdd,partition
metadata_services=cloudbaseinit.metadata.services.configdrive.ConfigDriveService
# No SetUserSSHPublicKeysPlugin: it writes the PROFILE's authorized_keys, which Windows
# sshd ignores for Administrators (and it crashes while the admin has never logged on,
# profile-less). The key lands in administrators_authorized_keys via the clone's
# user-data script (modules/vm-windows) — the file sshd actually reads for admins.
plugins={{ platform_windows_cloudbase_plugins | join(',') }}
# SetHostName applies at a reboot: allow cloudbase its one reboot so a clone's first
# boot ends with the right name (it was pending forever with false, seen 2026-10-14).
allow_reboot=true
stop_service_on_exit=false
check_latest_version=false
# The MSI creates this log dir; a logdir that does not exist kills the service on start
# (oslo_log opens its file before anything else — exit 1067, no trace, seen 2026-10-14).
logdir=C:\Program Files\Cloudbase Solutions\Cloudbase-Init\log\
logfile=cloudbase-init.log
