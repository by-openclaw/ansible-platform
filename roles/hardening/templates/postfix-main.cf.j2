# ==============================================================================
# /etc/postfix/main.cf — managed by Ansible (role: hardening)
# Mode: satellite (relay only — no local delivery except root)
# ==============================================================================

# ---- Identity ----
myhostname = {{ hardening_email_hostname }}.{{ hardening_email_helo_domain }}
# The domain, not $myhostname: root@<domain> has to be a deliverable address, and
# mail-identity.yml (always applied) already sets myorigin this way. The two must agree.
myorigin   = {{ hardening_email_helo_domain }}

# ---- Relay ----
relayhost = [{{ hardening_email_relay_host }}]:{{ hardening_email_relay_port }}

# ---- SASL auth to relay ----
smtp_sasl_auth_enable          = yes
smtp_sasl_password_maps        = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options     = noanonymous
smtp_tls_security_level        = encrypt
smtp_tls_CAfile                = /etc/ssl/certs/ca-certificates.crt

# ---- Local delivery: root only ----
mydestination =
local_recipient_maps =
local_transport = error:local delivery disabled

# ---- Sender rewrite ----
sender_canonical_maps = static:{{ hardening_email_from }}

# ---- Restrictions ----
inet_interfaces = loopback-only
inet_protocols  = all
smtpd_banner = $myhostname ESMTP
# Local SMTP submission (loopback :25) for submitters that cannot use the sendmail
# binary — AIDE's _aide unit via s-nail. Without an explicit relay policy smtpd
# refused to start ("specify at least one working instance of ...
# reject_unauth_destination"), so this listener never worked: loopback clients
# relay, anything else is refused (and nothing else can reach a loopback socket).
mynetworks = 127.0.0.0/8 [::1]/128
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
