# ==============================================================================
# /etc/ssh/sshd_config — managed by Ansible (role: hardening)
# DO NOT EDIT MANUALLY — changes will be overwritten
# Template: roles/hardening/templates/sshd_config.j2
# ==============================================================================

# ---- Port ----
# Only one port — no Port 22 line. Default port 22 is NOT enabled.
Port {{ hardening_ssh_port }}

# ---- Address families ----
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

# ---- Host keys ----
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# ---- Authentication ----
PermitRootLogin {{ hardening_ssh_permit_root_login }}
PubkeyAuthentication {{ hardening_ssh_pubkey_auth }}
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication {{ hardening_ssh_password_auth }}
PermitEmptyPasswords no
ChallengeResponseAuthentication {{ hardening_ssh_challenge_response }}
UsePAM yes
KbdInteractiveAuthentication no

# ---- Access control ----
# Only members of these groups can connect (key-based by default)
AllowGroups {{ hardening_ssh_allow_groups | join(' ') }} {{ hardening_ssh_break_glass_group }}

# ---- Limits ----
MaxAuthTries {{ hardening_ssh_max_auth_tries }}
LoginGraceTime {{ hardening_ssh_login_grace_time }}
MaxSessions 10

# ---- Session ----
X11Forwarding {{ hardening_ssh_x11_forwarding }}
PrintMotd no
TCPKeepAlive yes
ClientAliveInterval {{ hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ hardening_ssh_client_alive_count_max }}

# ---- Forwarding ----
AllowAgentForwarding no
AllowTcpForwarding no
GatewayPorts no
PermitTunnel no

# ---- Misc ----
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server

# ==============================================================================
# Break-glass block
# Password authentication allowed ONLY for:
#   - Group: {{ hardening_ssh_break_glass_group }}
#   - From networks: {{ hardening_ssh_break_glass_networks | join(', ') }}
# This enables emergency access when certificates/keys are unavailable.
# Networks are restricted to OOB/MGMT — never internet-facing.
# ==============================================================================
Match Group {{ hardening_ssh_break_glass_group }} Address {{ hardening_ssh_break_glass_networks | join(',') }}
    PasswordAuthentication yes
    AuthenticationMethods password
    # No key forwarding even for break-glass
    AllowAgentForwarding no
    AllowTcpForwarding no
