{{ ansible_managed | comment }}
# docker-compose.override.yml — managed by the mailcow role.
# Purpose: relocate the vmail Maildir onto the Synology NFS mount. ONLY
# vmail-vol-1 (the Maildir) is moved; vmail-index-vol-1 (Dovecot indexes) stays
# on the local disk on purpose — Dovecot indexes over NFS are a locking/perf
# hazard. The host path below is the NFS mountpoint (see install.yml).
#
# Official method: https://docs.mailcow.email/manual-guides/Dovecot/u_e-dovecot-vmail-volume/

services: {}

volumes:
  vmail-vol-1:
    driver_opts:
      type: none
      device: {{ mailcow_vmail_local_mount }}
      o: bind
