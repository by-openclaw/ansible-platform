# Managed by Ansible (roles/mailcow) — rclone remote for the mailcow backup upload. Root only.
RCLONE_CONFIG_DST_TYPE=s3
RCLONE_CONFIG_DST_PROVIDER=SeaweedFS
RCLONE_CONFIG_DST_ENDPOINT={{ mailcow_s3.endpoint }}
RCLONE_CONFIG_DST_FORCE_PATH_STYLE=true
RCLONE_CONFIG_DST_ACCESS_KEY_ID={{ mailcow_s3.access_key }}
RCLONE_CONFIG_DST_SECRET_ACCESS_KEY={{ mailcow_s3.secret_key }}
MAILCOW_S3_BUCKET={{ mailcow_s3.buckets[0] }}
