# Managed by Ansible (role: mailcow). Replaces the block of local.d/antivirus.conf: the same
# scanner, with the size limit and the timeout of tasks/limits.yml.
clamav {
  scan_mime_parts = false;
  symbol = "CLAM_VIRUS";
  type = "clamav";
  log_clean = true;
  servers = "clamd:3310";
  max_size = {{ mailcow_antivirus_limit_mb | int * 1048576 }};
  timeout = {{ mailcow_antivirus_timeout_s }};
}
