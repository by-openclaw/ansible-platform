# Managed by Ansible (role: mailcow). Dovecot reads this file last: mailcow's own place for
# persistent overrides of dovecot.conf.
#
# The sign-in line also names the account that authenticated: for a sign-in made with the master
# user it differs from the mailbox (user=<mailbox> auth_user=<master>).
login_log_format_elements = "{{ mailcow_dovecot_login_log_format }}"
