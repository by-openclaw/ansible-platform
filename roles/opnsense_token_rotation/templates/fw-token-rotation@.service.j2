# {{ ansible_managed }}
# Rotate the FW API token for %i (SEC-09). Then the catalog must still converge with the new
# token: fw-token-rotation-check@%i runs the catalog's DNS part in check mode and
# fw-token-rotation-gate@%i reads its result — three units, each one plain command, where a
# shell had a pipe (infra/0010 §4). Output in the journal
# (journalctl --user -u 'fw-token-rotation*@%i').
[Unit]
Description=Rotate the OPNsense Ansible API token for %i (SEC-09)
After=network-online.target
OnSuccess=fw-token-rotation-check@%i.service

[Service]
Type=oneshot
WorkingDirectory={{ opnsense_token_rotation_repo }}
Environment=PATH={{ opnsense_token_rotation_ansible_bin }}:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1 ANSIBLE_FORCE_COLOR=0 ANSIBLE_NOCOLOR=1
Environment=SSH_AUTH_SOCK={{ opnsense_token_rotation_agent_socket }}
ExecStart={{ opnsense_token_rotation_ansible_bin }}/ansible-playbook -i inventories/%i playbooks/opnsense-api-bootstrap.yml -e opnsense_api_bootstrap_force_rotate=true
