# Managed by Ansible role `opnsense_token_rotation`. Do not edit by hand.
[Unit]
Description=Rotate the OPNsense Ansible API token for %i (SEC-09) and gate on a catalog check
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ opnsense_token_rotation_repo }}
Environment=PATH={{ opnsense_token_rotation_ansible_bin }}:/usr/local/bin:/usr/bin:/bin
ExecStart={{ opnsense_token_rotation_bin_dir }}/fw-token-rotate.sh %i
