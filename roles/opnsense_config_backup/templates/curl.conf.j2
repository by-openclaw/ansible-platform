# Managed by Ansible (roles/opnsense_config_backup) — root 0600.
# curl reads the firewall's API key and secret from this file (-K): they are never an argument
# of a command, so never in the host's process list.
user = "{{ opnsense_config_backup_fw_key | replace('\\', '\\\\') | replace('"', '\\"') }}:{{ opnsense_config_backup_fw_secret | replace('\\', '\\\\') | replace('"', '\\"') }}"
