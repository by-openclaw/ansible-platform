{# Managed by Ansible (role: grafana) — provisioned datasources. #}
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: "{{ grafana_prometheus_url }}"
    isDefault: true
    editable: false
{% if grafana_loki_url | length > 0 %}
  - name: Loki
    type: loki
    access: proxy
    url: "{{ grafana_loki_url }}"
    editable: false
{% endif %}
