{# Managed by Ansible (role: grafana) — provisioned datasources. #}
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: "{{ grafana_prometheus_url }}"
    isDefault: true
    editable: false
{% if grafana_loki_url | length > 0 %}
  - name: Loki
    type: loki
    access: proxy
    url: "{{ grafana_loki_url }}"
    editable: false
{% endif %}
{% if grafana_alertmanager_url | default('') | length > 0 %}
  - name: Alertmanager
    type: alertmanager
    access: proxy
    url: "{{ grafana_alertmanager_url }}"
    editable: false
    jsonData:
      implementation: prometheus
      handleGrafanaManagedAlerts: false
{% endif %}
