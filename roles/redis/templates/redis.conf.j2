{# Managed by Ansible role `redis` (container). Do not edit by hand. #}
bind 0.0.0.0 ::
protected-mode yes

# TLS — shared wildcard cert mounted from the host (tls_cert role).
{% if redis_tls | bool %}
port 0
tls-port {{ redis_tls_port }}
tls-cert-file {{ redis_tls_cert }}
tls-key-file {{ redis_tls_key }}
# The bundle FILE, not the directory: the host's /etc/ssl/certs is mounted, and its hashed
# entries are symlinks to files outside the mount — a replica could not verify its primary.
tls-ca-cert-file {{ redis_ca_bundle }}
tls-auth-clients no
tls-replication yes
{% else %}
port {{ redis_port }}
{% endif %}

# Auth. Every login — the default user (administration, replication, Sentinel) and one per
# consumer — is in the ACL file. NOT here: when the Sentinels change this member's role, Redis
# rewrites its start file and copies every login it knows into it, unless an ACL file holds
# them; a login then stood in two files and Redis refused to start ("Duplicate user found") —
# a member that had been through a failover could not restart (kill drill of 2026-10-04).
aclfile {{ redis_acl_file }}

# Replication — the same on every member. Who replicates from whom is NOT here: Sentinel
# decides, and the member's start file carries its `replicaof` line.
masterauth {{ redis_requirepass }}
replica-announce-ip {{ redis_fqdn }}
replica-announce-port {{ redis_port }}
replica-read-only yes

# Durability — AOF so a future replica/Sentinel can attach (HA-adoptable).
dir /data
appendonly {{ redis_appendonly }}
appendfsync everysec
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}
