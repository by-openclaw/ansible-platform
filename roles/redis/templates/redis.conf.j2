{# Managed by Ansible role `redis` (container). Do not edit by hand. #}
bind 0.0.0.0 ::
protected-mode yes

# TLS — shared wildcard cert mounted from the host (tls_cert role).
{% if redis_tls | bool %}
port 0
tls-port {{ redis_tls_port }}
tls-cert-file {{ redis_tls_cert }}
tls-key-file {{ redis_tls_key }}
tls-ca-cert-dir /etc/ssl/certs
tls-auth-clients no
tls-replication yes
{% else %}
port {{ redis_port }}
{% endif %}

# Auth.
requirepass {{ redis_requirepass }}

# Durability — AOF so a future replica/Sentinel can attach (HA-adoptable).
dir /data
appendonly {{ redis_appendonly }}
appendfsync everysec
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}
