{# Managed by Ansible role `traefik_route`. Do not edit by hand.
   internal_only=true  -> ipAllowList (LAN + VPN).
   internal_only=false -> public: per-client rateLimit (brute-force throttle).
   forward_auth=true    -> add the global Authentik `authentik` forwardAuth middleware
                           + a per-host outpost sub-router (login callback/assets).
   The `authentik` middleware and `authentik-outpost` service are defined globally in
   the traefik role's dynamic.yml.j2 (file provider) — referenced here by name.
   traefik_route_endpoints non-empty -> several backends under ONE host name, one
                           router+service per entry in THIS file (NetBird: gRPC
                           management/signal, REST, ws, relay, dashboard). The network
                           middleware applies to every endpoint, same as a single route. #}
{% if traefik_route_internal_only | bool %}
{%   set _net_mw = traefik_route_name ~ '-internal' %}
{% elif traefik_route_public_hardening | bool %}
{%   set _net_mw = traefik_route_name ~ '-ratelimit' %}
{% else %}
{%   set _net_mw = '' %}
{% endif %}
{% set _mws = [] %}
{% if traefik_route_path_prefix | length > 0 and traefik_route_strip_prefix | bool %}{% set _ = _mws.append(traefik_route_name ~ '-strip') %}{% endif %}
{% if _net_mw %}{% set _ = _mws.append(_net_mw) %}{% endif %}
{% if traefik_route_path_prefix | length > 0 %}
{%   set _rule = traefik_route_rule ~ ' && PathPrefix(`' ~ traefik_route_path_prefix ~ '`)' %}
{% else %}
{%   set _rule = traefik_route_rule %}
{% endif %}
{% if traefik_route_forward_auth | bool %}{% set _ = _mws.append('authentik') %}{% endif %}
http:
  routers:
{% if traefik_route_endpoints | length > 0 %}
{% for ep in traefik_route_endpoints %}
{%   set _prefixes = ep.path_prefixes | default([]) %}
{%   if _prefixes | length > 1 %}
{%     set _ep_rule = traefik_route_rule ~ ' && (' ~ (_prefixes | map('regex_replace', '^(.*)$', 'PathPrefix(`\\1`)') | join(' || ')) ~ ')' %}
{%   elif _prefixes | length == 1 %}
{%     set _ep_rule = traefik_route_rule ~ ' && PathPrefix(`' ~ _prefixes[0] ~ '`)' %}
{%   else %}
{%     set _ep_rule = traefik_route_rule %}
{%   endif %}
    {{ traefik_route_name }}-{{ ep.name }}:
      rule: "{{ _ep_rule }}"
      entryPoints:
        - websecure
      service: {{ traefik_route_name }}-{{ ep.name }}
{% if ep.priority is defined %}
      priority: {{ ep.priority }}
{% endif %}
{% if _mws %}
      middlewares:
{% for m in _mws %}
        - {{ m }}
{% endfor %}
{% endif %}
      tls: {}
{% endfor %}
{% else %}
    {{ traefik_route_name }}:
      rule: "{{ _rule }}"
{% if traefik_route_path_prefix | length > 0 %}
      priority: 50   # path route wins over the plain host route of the same name
{% endif %}
      entryPoints:
        - websecure
      service: {{ traefik_route_name }}
{% if _mws %}
      middlewares:
{% for m in _mws %}
        - {{ m }}
{% endfor %}
{% endif %}
      tls: {}
{% if traefik_route_forward_auth | bool %}

    # Authentik outpost endpoints on this host (login callback + assets). MUST NOT
    # carry the `authentik` middleware (it IS the auth flow) — only the network gate.
    {{ traefik_route_name }}-outpost:
      rule: "Host(`{{ traefik_route_fqdn }}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      priority: 100
      entryPoints:
        - websecure
      service: authentik-outpost
{% if _net_mw %}
      middlewares:
        - {{ _net_mw }}
{% endif %}
      tls: {}
{% endif %}

{% endif %}
  services:
{% if traefik_route_endpoints | length > 0 %}
{% for ep in traefik_route_endpoints %}
    {{ traefik_route_name }}-{{ ep.name }}:
      loadBalancer:
        servers:
          - url: "{{ ep.backend_url }}"
{% if traefik_route_backend_insecure_skip_verify | bool or traefik_route_backend_root_ca_file | length > 0 %}
        serversTransport: {{ traefik_route_name }}-transport
{% endif %}
{% endfor %}
{% else %}
    {{ traefik_route_name }}:
      loadBalancer:
        servers:
          - url: "{{ traefik_route_backend_url }}"
{% if traefik_route_backend_insecure_skip_verify | bool or traefik_route_backend_root_ca_file | length > 0 %}
        serversTransport: {{ traefik_route_name }}-transport
{% endif %}
{% endif %}
{% if traefik_route_backend_insecure_skip_verify | bool %}

  serversTransports:
    {{ traefik_route_name }}-transport:
      insecureSkipVerify: true
{% elif traefik_route_backend_root_ca_file | length > 0 %}

  serversTransports:
    {{ traefik_route_name }}-transport:
      rootCAs:
        - "{{ traefik_route_backend_root_ca_file }}"
{% endif %}
{% if _net_mw or (traefik_route_path_prefix | length > 0 and traefik_route_strip_prefix | bool) %}

  middlewares:
{% if traefik_route_path_prefix | length > 0 and traefik_route_strip_prefix | bool %}
    {{ traefik_route_name }}-strip:
      stripPrefix:
        prefixes:
          - "{{ traefik_route_path_prefix }}"
{% endif %}
{% if not _net_mw %}
{% elif traefik_route_internal_only | bool %}
    {{ traefik_route_name }}-internal:
      ipAllowList:
        sourceRange:
{% for cidr in traefik_route_internal_cidrs %}
          - "{{ cidr }}"
{% endfor %}
{% for cidr in traefik_route_admin_cidrs %}
          - "{{ cidr }}"
{% endfor %}
{% else %}
    {{ traefik_route_name }}-ratelimit:
      rateLimit:
        average: {{ traefik_route_ratelimit_average }}
        burst: {{ traefik_route_ratelimit_burst }}
{% endif %}
{% endif %}
