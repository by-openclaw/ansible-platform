{
  "identities": [
    {
      "name": "admin",
      "credentials": [{"accessKey": "{{ seaweedfs_creds.admin_access_key }}", "secretKey": "{{ seaweedfs_creds.admin_secret_key }}"}],
      "actions": ["Admin", "Read", "Write", "List", "Tagging"]
    },
    {
      "name": "gitlab",
      "credentials": [{"accessKey": "{{ seaweedfs_creds.gitlab_access_key }}", "secretKey": "{{ seaweedfs_creds.gitlab_secret_key }}"}],
      "actions": [
{% for b in seaweedfs_gitlab_buckets %}        "Read:{{ b }}", "Write:{{ b }}", "List:{{ b }}", "Tagging:{{ b }}"{{ "," if not loop.last else "" }}
{% endfor %}
      ]
    },
    {
      "name": "backup",
      "credentials": [{"accessKey": "{{ seaweedfs_creds.backup_access_key }}", "secretKey": "{{ seaweedfs_creds.backup_secret_key }}"}],
      "actions": ["Read:backup-staging", "Write:backup-staging", "List:backup-staging", "Tagging:backup-staging"]
    }
  ]
}
