# Managed by ansible (seaweedfs role) — do not edit by hand.
# Access is gated by Authentik forwardAuth at Traefik ({{ seaweedfs_admin_group }} group); the FW
# permits ONLY Traefik -> :{{ seaweedfs_admin_port }}. Since SeaweedFS 4.47 the admin binds a
# non-loopback address only with a local credential (from {{ seaweedfs_admin_env_file }}, Vault-minted).
[Unit]
Description=SeaweedFS web admin dashboard (Authentik-gated via Traefik)
After=seaweedfs.service network-online.target
Wants=seaweedfs.service

[Service]
Type=simple
User={{ seaweedfs_user }}
Group={{ seaweedfs_group }}
EnvironmentFile={{ seaweedfs_admin_env_file }}
ExecStart={{ seaweedfs_bin }} admin \
  -ip={{ seaweedfs_ip }} \
  -port={{ seaweedfs_admin_port }} \
  -master=localhost:{{ seaweedfs_master_port }} \
  -dataDir={{ seaweedfs_admin_data_dir }} \
  -adminUser=${SEAWEEDFS_ADMIN_USER} \
  -adminPassword=${SEAWEEDFS_ADMIN_PASSWORD}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
