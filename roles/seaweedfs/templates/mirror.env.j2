# Managed by Ansible (roles/seaweedfs mirrors) — rclone remotes for mirror {{ seaweedfs_mirror.name }}. Root only.
RCLONE_CONFIG_SRC_TYPE=s3
RCLONE_CONFIG_SRC_PROVIDER=Other
RCLONE_CONFIG_SRC_ENDPOINT={{ seaweedfs_mirror.source.endpoint }}
RCLONE_CONFIG_SRC_REGION={{ seaweedfs_mirror.source.region }}
RCLONE_CONFIG_SRC_FORCE_PATH_STYLE={{ 'true' if seaweedfs_mirror.source.path_style | default(true) else 'false' }}
RCLONE_CONFIG_SRC_ACCESS_KEY_ID={{ seaweedfs_mirror_src.access_key }}
RCLONE_CONFIG_SRC_SECRET_ACCESS_KEY={{ seaweedfs_mirror_src.secret_key }}
RCLONE_CONFIG_DST_TYPE=s3
RCLONE_CONFIG_DST_PROVIDER=SeaweedFS
RCLONE_CONFIG_DST_ENDPOINT=http://127.0.0.1:{{ seaweedfs_s3_port }}
RCLONE_CONFIG_DST_FORCE_PATH_STYLE=true
# The destination identity is scoped to its two buckets and may not create one: rclone must not
# try (its CreateBucket before a copy into the trash bucket was refused with 403, and every run
# that had a changed object to set aside failed — 2026-10-03 to 2026-10-06).
RCLONE_CONFIG_DST_NO_CHECK_BUCKET=true
RCLONE_CONFIG_DST_ACCESS_KEY_ID={{ seaweedfs_mirror_dst.access_key }}
RCLONE_CONFIG_DST_SECRET_ACCESS_KEY={{ seaweedfs_mirror_dst.secret_key }}
