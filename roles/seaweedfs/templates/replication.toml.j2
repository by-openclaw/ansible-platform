# Managed by ansible (seaweedfs role) — do not edit by hand.
# weed filer.backup sink → Contabo S3 (offsite backup of {{ seaweedfs_offsite_filer_path }}).
[sink.s3]
enabled = true
aws_access_key_id = "{{ seaweedfs_offsite.access_key }}"
aws_secret_access_key = "{{ seaweedfs_offsite.secret_key }}"
region = "{{ seaweedfs_offsite.region }}"
bucket = "{{ seaweedfs_offsite.bucket }}"
directory = "/"
endpoint = "{{ seaweedfs_offsite.endpoint }}"
is_incremental = {{ 'true' if seaweedfs_offsite_is_incremental else 'false' }}
