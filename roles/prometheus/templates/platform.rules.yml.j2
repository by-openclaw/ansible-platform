# Managed by Ansible (role: prometheus). Do not edit by hand.
groups:
  - name: platform-probes
    rules:
      - alert: ResolverDown
        expr: probe_success{job=~"blackbox_dns_v[46]"} == 0
        for: {{ prometheus_alert_resolver_for }}
        labels: {severity: critical}
        annotations:
          summary: "Platform resolver {{ '{{' }} $labels.instance {{ '}}' }} does not answer"
          description: "The guests' first nameserver ({{ '{{' }} $labels.instance {{ '}}' }}) has not answered the {{ '{{' }} $labels.job {{ '}}' }} lookup for {{ prometheus_alert_resolver_for }}. Every lookup on every guest stalls up to 5 s until it is back, so most other probes fail with it (#424)."
          runbook: "Check the resolver chain in order: AdGuard on {{ groups['adguard'] | first }} → the firewall's Unbound → dnscrypt. A firewall rebuild or reboot looks exactly like this. The probe alerts this one explains are held back until it clears."
      - alert: ProbeFailed
        expr: probe_success{job!~"blackbox_dns_v[46]"} == 0
        for: {{ prometheus_alert_probe_for }}
        labels: {severity: critical}
        annotations:
          summary: "{{ '{{' }} $labels.job {{ '}}' }} probe failed for {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "{{ groups['monitoring'] | first }} could not complete the {{ '{{' }} $labels.job {{ '}}' }} check against this target for {{ prometheus_alert_probe_for }}: the service is down, unreachable from the monitoring host, or answering wrongly (bad status code, TLS or DNS)."
          runbook: "Many targets at once = the path, not the services: check the firewall (rebuild, reboot, ISP) and the resolver first. One target = open it from inside (curl from {{ groups['vault'] | first }}) and read that service's log; a 403 on everything is the CrowdSec bouncer."
      - alert: TLSCertExpiringSoon
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < {{ prometheus_alert_cert_warn_days }}
        for: 1h
        labels: {severity: warning}
        annotations:
          summary: "Certificate on {{ '{{' }} $labels.instance {{ '}}' }} expires in {{ '{{' }} $value | printf \"%.0f\" {{ '}}' }} days"
          description: "The certificate served by {{ '{{' }} $labels.instance {{ '}}' }} is inside the {{ prometheus_alert_cert_warn_days }}-day warning window. Renewals are automatic (Traefik ACME, lego, or the firewall's ACME client); this fires when a renewal has silently stopped."
          runbook: "Find the issuer for this name (Traefik: check its ACME log; lego: run the renew play; firewall: the ACME family in opnsense.yml) and read the last renewal attempt's error before anything else."
      - alert: TLSCertExpiryCritical
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < {{ prometheus_alert_cert_crit_days }}
        for: 10m
        labels: {severity: critical}
        annotations:
          summary: "Certificate on {{ '{{' }} $labels.instance {{ '}}' }} expires in {{ '{{' }} $value | printf \"%.0f\" {{ '}}' }} days"
          description: "The certificate served by {{ '{{' }} $labels.instance {{ '}}' }} expires within {{ prometheus_alert_cert_crit_days }} days: clients will start refusing the site. Renewal has been failing for a while (the warning fired first)."
          runbook: "Renew now through the owner of that name (Traefik ACME log, lego renew play, or the firewall ACME family) and fix the cause the log shows (DNS challenge, rate limit, expired token)."
  - name: platform-hosts
    rules:
      - alert: TargetDown
        expr: up == 0
        for: 5m
        labels: {severity: critical}
        annotations:
          summary: "{{ '{{' }} $labels.job {{ '}}' }} target {{ '{{' }} $labels.instance {{ '}}' }} is not scrapeable"
          description: "Prometheus has not been able to scrape {{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.job {{ '}}' }}) for 5 min: the host is down, its exporter stopped, or the host firewall no longer admits the monitoring host."
          runbook: "Ping it, then check the exporter unit on the host (node_exporter / cadvisor) and its host firewall; if many hosts drop together, look at the hypervisor and the firewall first."
      - alert: HostDiskAlmostFull
        expr: (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"} / node_filesystem_size_bytes) < {{ prometheus_alert_disk_free_ratio }}
        for: 15m
        labels: {severity: warning}
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} {{ '{{' }} $labels.mountpoint {{ '}}' }} has {{ '{{' }} $value | humanizePercentage {{ '}}' }} free"
          description: "The filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has been below {{ (prometheus_alert_disk_free_ratio * 100) | int }} % free for 15 min. Services on it will fail to write once it is full (databases, logs, backups)."
          runbook: "Find what grows (journal, docker images, backups, a runaway log) with du on that mount; prune or grow the disk through the infra repo, not by hand."
      - alert: SeaweedFSVolumeSlotsLow
        expr: >-
          max by (instance) (SeaweedFS_volumeServer_max_volumes)
          - sum by (instance) (SeaweedFS_volumeServer_volumes{type="volume"})
          < {{ prometheus_alert_seaweedfs_free_slots }}
        for: 10m
        labels: {severity: critical}
        annotations:
          summary: "SeaweedFS on {{ '{{' }} $labels.instance {{ '}}' }} has {{ '{{' }} $value {{ '}}' }} free volume slots"
          description: "When no volume slot is free every S3 write fails with HTTP 500 — PBS backups, GitLab artifacts, Loki, Harbor. Slots run out before the disk does (partly filled per-bucket volumes)."
          runbook: "Raise seaweedfs_volume_max in roles/seaweedfs (the disk quota is the real ceiling — check HostDiskAlmostFull on /data), run playbooks/seaweedfs.yml, then re-run any failed backups."
      - alert: HostOutOfMemory
        expr: (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) < {{ prometheus_alert_mem_free_ratio }}
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} has {{ '{{' }} $value | humanizePercentage {{ '}}' }} memory available"
          description: "{{ '{{' }} $labels.instance {{ '}}' }} has had less than {{ (prometheus_alert_mem_free_ratio * 100) | int }} % of its memory available for 10 min: the kernel is about to kill processes or the host is swapping."
          runbook: "Look at the top consumers (docker stats / top); restart the leaking service or raise the guest's memory through the infra repo."
      - alert: ZfsPoolNotOnline
        # one alert per pool: every LXC of the node reports the node's pool state too
        expr: max by (zpool, state) (node_zfs_zpool_state{state!="online"}) == 1
        for: 2m
        labels: {severity: critical}
        annotations:
          summary: "ZFS pool {{ '{{' }} $labels.zpool {{ '}}' }} is {{ '{{' }} $labels.state {{ '}}' }}"
          description: "The pool is not ONLINE: a disk failed or was removed and a mirror runs without redundancy (2026-10-03: a drive of the hypervisor's pool failed and nothing alerted). A second failure in the same mirror loses the pool — every guest disk and the object storage."
          runbook: "On the node: `zpool status -x` names the device; replace the physical disk, then `zpool replace <pool> <old> <new>` and watch the resilver. Do not reboot the node before the replacement (a Smart Array with a failed logical drive can stop at the boot prompt)."
      - alert: AlertmanagerUnreachable
        expr: prometheus_notifications_alertmanagers_discovered < 1
        for: 5m
        labels: {severity: critical}
        annotations:
          summary: "Prometheus has no Alertmanager — alerts are not delivered"
          description: "Prometheus cannot reach its Alertmanager: rules still evaluate but nothing is sent by mail or to Discord. This alert reaches you only through the Prometheus UI or Grafana."
          runbook: "On {{ groups['monitoring'] | first }}: check the prometheus-alertmanager unit and its /-/ready endpoint, then the alertmanager role's last run."
  - name: platform-database
    rules:
      - alert: PostgresConnectionsNearMax
        expr: sum by (instance) (pg_stat_activity_count) / on (instance) pg_settings_max_connections > {{ prometheus_alert_pg_conn_warn_ratio }}
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "PostgreSQL on {{ '{{' }} $labels.instance {{ '}}' }} is at {{ '{{' }} $value | humanizePercentage {{ '}}' }} of its connection ceiling"
          description: "The shared cluster is close to max_connections. When it is reached every service that needs a new connection fails at once — on 2026-09-22 that meant the identity provider losing its pool and every route behind it answering 500."
          runbook: "Name the client before raising anything: the cluster logs connections, so count them per role in Loki (container postgres, lines 'connection authorized'). A role that opens a connection per request needs a lifetime or a bounded pool, not a higher ceiling."
      - alert: PostgresConnectionsCritical
        expr: sum by (instance) (pg_stat_activity_count) / on (instance) pg_settings_max_connections > {{ prometheus_alert_pg_conn_crit_ratio }}
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "PostgreSQL on {{ '{{' }} $labels.instance {{ '}}' }} is at {{ '{{' }} $value | humanizePercentage {{ '}}' }} of its connection ceiling"
          description: "New connections are about to be refused ('remaining connection slots are reserved for roles with the SUPERUSER attribute'). Every service sharing this cluster is affected within seconds."
          runbook: "Find the role holding the most backends (pg_stat_activity by usename) and stop its bleeding first — restart that service's pool, then fix its connection lifetime. Raising max_connections is the last resort, not the first."
      - alert: PostgresLeaderCount
        # the cluster's heartbeat: exactly ONE member is not a replica
        expr: count(pg_replication_is_replica == 0) != 1
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "The PostgreSQL cluster has {{ '{{' }} $value {{ '}}' }} leaders (expected 1)"
          description: "Either no member leads (writes fail on every service with a database) or two do. Patroni elects a leader through etcd: a lost quorum of the consensus store (two of three members down) leaves the cluster without one."
          runbook: "On any member: `docker exec postgres patronictl -c /etc/postgres/patroni/patroni.yml list`, then `docker exec etcd etcdctl endpoint health --cluster`. Bring the missing members back (playbooks/postgresql.yml); never promote by hand."
      - alert: PostgresReplicaMissing
        expr: count(pg_replication_is_replica == 1) < {{ (prometheus_postgres_exporter_hosts | length) - 1 }}
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "The PostgreSQL cluster runs with {{ '{{' }} $value {{ '}}' }} replicas (expected {{ (prometheus_postgres_exporter_hosts | length) - 1 }})"
          description: "A member is down or not streaming: the cluster still serves, with less redundancy. With no replica left a failure of the leader is an outage."
          runbook: "`patronictl list` on a member names the missing one; `playbooks/postgresql.yml -l <member>` converges it (a member that fell too far behind is re-copied with `patronictl reinit`)."
      - alert: PostgresEndpointNoLeader
        expr: haproxy_backend_active_servers{proxy="postgres"} != 1
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "The data endpoint routes PostgreSQL to {{ '{{' }} $value {{ '}}' }} members (expected 1)"
          description: "The endpoint sends connections to the member whose Patroni answers /primary. Zero = no leader, or the endpoint cannot reach the members' REST API; every service that connects through the endpoint fails."
          runbook: "Compare `patronictl list` with the endpoint's view (`curl -s localhost:8405/metrics | grep haproxy_server_status` on the endpoint guest); then the firewall catalog entry of port 8008 and the members' certificates."
      - alert: RedisEndpointNoPrimary
        expr: haproxy_backend_active_servers{proxy="redis"} != 1
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "The data endpoint routes Redis to {{ '{{' }} $value {{ '}}' }} members (expected 1)"
          description: "The endpoint sends connections to the member that answers role:master. Zero = no primary (both members down, or the Sentinels have no quorum to promote the replica); sessions, queues and locks of every consumer fail."
          runbook: "On a member: `docker exec redis-sentinel redis-cli --tls ... sentinel master {{ platform_redis_master_name | default('platform-redis') }}`; bring the missing member or Sentinel back (playbooks/redis.yml). Never run REPLICAOF by hand while the Sentinels are up."
      - alert: PostgresDown
        expr: pg_up == 0
        for: 2m
        labels: {severity: critical}
        annotations:
          summary: "PostgreSQL on {{ '{{' }} $labels.instance {{ '}}' }} does not answer its metrics scrape"
          description: "The exporter cannot reach the cluster: either PostgreSQL is down, or the exporter's own credential stopped working. Every service with a database is affected."
          runbook: "Check the container on the database host, then the exporter's credential in Vault ({{ platform_env }}/postgresql/exporter)."

  - name: platform-containers
    rules:
      - alert: ContainerRestarting
        expr: changes(container_start_time_seconds{name!=""}[15m]) > 2
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "Container {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} restarted {{ '{{' }} $value {{ '}}' }} times in 15 min"
          description: "Container {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is in a restart loop: it crashes right after starting (bad config, missing secret, dependency not up)."
          runbook: "docker logs --tail 100 on the container; a config or secret change is the usual cause, so check the last deploy of that service."
      - alert: ContainerMemoryNearLimit
        expr: (container_memory_working_set_bytes{name!=""} / (container_spec_memory_limit_bytes{name!=""} > 0)) > 0.9
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "Container {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} uses {{ '{{' }} $value | humanizePercentage {{ '}}' }} of its memory limit"
          description: "Container {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} sits above 90 % of its memory limit for 10 min: the runtime will OOM-kill it at 100 %."
          runbook: "Check whether the load is legitimate (docker stats, the service's own metrics); raise the limit in the role's compose defaults or fix the leak."
