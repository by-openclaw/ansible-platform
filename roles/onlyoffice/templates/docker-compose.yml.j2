# Managed by Ansible (roles/onlyoffice). ONLYOFFICE Docs, pinned.
services:
  onlyoffice:
    image: {{ onlyoffice_image }}
    restart: unless-stopped
    ports:
      - "{{ onlyoffice_http_ip }}:{{ onlyoffice_http_port }}:80"
    env_file: [.env]
    volumes:
      - onlyoffice-data:/var/www/onlyoffice/Data
      - onlyoffice-log:/var/log/onlyoffice
      - onlyoffice-lib:/var/lib/onlyoffice
    stop_grace_period: 60s
volumes:
  onlyoffice-data: {}
  onlyoffice-log: {}
  onlyoffice-lib: {}
