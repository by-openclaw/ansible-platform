# Managed by Ansible (roles/onlyoffice). Secrets from Vault {{ onlyoffice_vault_path }}.
JWT_ENABLED=true
JWT_SECRET={{ onlyoffice_secrets.jwt_secret }}
JWT_HEADER={{ onlyoffice_jwt_header }}
JWT_IN_BODY=false
USE_UNAUTHORIZED_STORAGE=false
WOPI_ENABLED=false
# Font set (AllFonts.js + x2t font config) is generated at container start; without it
# the editor never finishes loading ("connection is too slow") and conversions abort.
GENERATE_FONTS=true
TZ={{ onlyoffice_timezone }}
